generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  password       String
  role           String    @default("CASHIER") // ADMIN, MANAGER, CASHIER
  phone          String?
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sales          Sale[]
  saleAdjustments SaleAdjustment[]
  salePayments   SalePayment[]
  stockMovements StockMovement[]
  shifts         Shift[]
  cashDrawerMovements CashDrawerMovement[]
  expenses       Expense[]
  dataMigrationAudits DataMigrationAudit[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  nameMm      String?
  description String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]
}

model Product {
  id                String    @id @default(cuid())
  name              String
  nameMm            String?
  sku               String    @unique
  barcode           String?   @unique
  categoryId        String
  costPrice         Decimal   @default(0) @db.Decimal(18, 2)
  sellingPrice      Decimal   @default(0) @db.Decimal(18, 2)
  stockQuantity     Decimal   @default(0) @db.Decimal(18, 3)
  lowStockThreshold Decimal   @default(10) @db.Decimal(18, 3)
  unit              String    @default("pcs") // pcs, kg, g, liter, ml, pack, box, bottle, dozen, set
  imageUrl          String?
  batchNumber       String?
  expiryDate        DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?  @unique
  email          String?
  address        String?
  totalPurchases Decimal  @default(0) @db.Decimal(18, 2)
  creditBalance  Decimal  @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal? @db.Decimal(18, 2)
  loyaltyPoints  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales        Sale[]
  salePayments SalePayment[]
}

model Sale {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  clientSaleId  String?  @unique
  customerId    String?
  userId        String
  subtotal      Decimal  @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal  @default(0) @db.Decimal(18, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(18, 2)
  dueAmount     Decimal  @default(0) @db.Decimal(18, 2)
  changeAmount  Decimal  @default(0) @db.Decimal(18, 2)
  pointsEarned  Int      @default(0)
  pointsRedeemed Int     @default(0)
  paymentMethod String   @default("CASH") // CASH, CARD, MOBILE_BANKING, CREDIT, SPLIT
  paymentStatus  String   @default("PAID") // PAID, PARTIAL, PENDING, FAILED, REVERSED
  paymentReference String?
  paymentProviderResponse String?
  status        String   @default("COMPLETED") // COMPLETED, PARTIALLY_REFUNDED, REFUNDED, VOIDED
  notes         String?
  createdAt     DateTime @default(now())

  customer       Customer?       @relation(fields: [customerId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  items          SaleItem[]
  payments       SalePayment[]
  stockMovements StockMovement[]
  adjustments    SaleAdjustment[]
  cashDrawerMovements CashDrawerMovement[]
}

model SalePayment {
  id         String   @id @default(cuid())
  saleId     String?
  customerId String?
  userId     String
  shiftId    String?
  method     String   // CASH, CARD, MOBILE_BANKING, CREDIT
  amount     Decimal  @db.Decimal(18, 2)
  reference  String?
  type       String   @default("CHECKOUT") // CHECKOUT, DEBT_REPAYMENT
  notes      String?
  createdAt  DateTime @default(now())

  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id])
  shift    Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([customerId])
  @@index([userId])
  @@index([shiftId])
}

model SaleAdjustment {
  id                    String   @id @default(cuid())
  saleId                String
  approverUserId        String
  type                  String   // REFUND, PARTIAL_REFUND, VOID
  reason                String
  amount                Decimal  @default(0) @db.Decimal(18, 2)
  paymentMethod         String
  paymentReversalStatus String   @default("PENDING") // PENDING, COMPLETED, FAILED, NOT_REQUIRED
  createdAt             DateTime @default(now())

  sale     Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  approver User @relation(fields: [approverUserId], references: [id])

  @@index([saleId])
  @@index([approverUserId])
}

model SaleItem {
  id               String  @id @default(cuid())
  saleId           String
  productId        String
  quantity         Decimal @default(1) @db.Decimal(18, 3)
  refundedQuantity Decimal @default(0) @db.Decimal(18, 3)
  unitPrice        Decimal @default(0) @db.Decimal(18, 2)
  costPrice        Decimal @default(0) @db.Decimal(18, 2) // Historical cost at time of sale
  discount         Decimal @default(0) @db.Decimal(18, 2)
  total            Decimal @default(0) @db.Decimal(18, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  userId        String
  saleId        String?  // Link to sale for OUT/RETURN movements
  quantity      Decimal  @db.Decimal(18, 3)
  type          String   // IN, OUT, ADJUSTMENT, RETURN
  reason        String?
  previousStock Decimal  @db.Decimal(18, 3)
  newStock      Decimal  @db.Decimal(18, 3)
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Decimal  @db.Decimal(18, 2)
  description String?
  userId      String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  cashDrawerMovements CashDrawerMovement[]
}

model Shift {
  id             String   @id @default(cuid())
  userId         String
  openingCash    Decimal  @default(0) @db.Decimal(18, 2)
  closingCash    Decimal? @db.Decimal(18, 2)
  expectedCash   Decimal? @db.Decimal(18, 2)
  actualCash     Decimal? @db.Decimal(18, 2)
  variance       Decimal? @db.Decimal(18, 2)
  status         String   @default("OPEN") // OPEN, CLOSED
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  notes          String?

  user User @relation(fields: [userId], references: [id])
  cashDrawerMovements CashDrawerMovement[]
  salePayments        SalePayment[]

  @@index([userId, status])
}

model CashDrawerMovement {
  id        String   @id @default(cuid())
  shiftId   String?
  saleId    String?
  expenseId String?
  userId    String
  type      String   // OPENING, CASH_SALE, REFUND, VOID, PAID_IN, PAID_OUT, CLOSING
  amount    Decimal  @db.Decimal(18, 2)
  reason    String?
  createdAt DateTime @default(now())

  shift   Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  sale    Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id])

  @@index([shiftId])
  @@index([saleId])
  @@index([expenseId])
  @@index([userId])
  @@index([type])
}

model Settings {
  id                String  @id @default("default")
  businessName      String  @default("ShwePOS")
  businessNameMm    String? @default("ရွှေPOS")
  address           String?
  phone             String?
  email             String?
  taxRate           Float   @default(0)
  currencySymbol    String  @default("K")
  logo              String?
  receiptFooter     String?
  loyaltyEnabled    Boolean @default(true)
  loyaltyEarnRate   Decimal @default(1000) @db.Decimal(18, 2)
  loyaltyRedeemRate Decimal @default(10) @db.Decimal(18, 2)
}

model InvoiceCounter {
  date    String @id // YYYYMMDD format
  counter Int    @default(0)
}

// Shared rate-limit state for serverless instances. This keeps login throttles
// effective when requests are handled by different Vercel functions.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model DataMigrationAudit {
  id        String   @id @default(cuid())
  userId    String
  action    String
  fileName  String
  fileHash  String
  rowCount  Int
  summary   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
