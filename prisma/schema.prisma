generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  password       String
  role           String    @default("CASHIER") // ADMIN, MANAGER, CASHIER
  phone          String?
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sales          Sale[]
  saleAdjustments SaleAdjustment[]
  salePayments   SalePayment[]
  stockMovements StockMovement[]
  shifts         Shift[]
  cashDrawerMovements CashDrawerMovement[]
  expenses       Expense[]
  dataMigrationAudits DataMigrationAudit[]
  purchaseOrders PurchaseOrder[]
  supplierPayments SupplierPayment[]
  auditLogs      AuditLog[]
  stocktakeSessions StocktakeSession[] @relation("StocktakeCreatedBy")
  completedStocktakes StocktakeSession[] @relation("StocktakeCompletedBy")
  quotations     Quotation[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  nameMm      String?
  description String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]
  promotions Promotion[]
  stocktakeSessions StocktakeSession[]
}

model Product {
  id                String    @id @default(cuid())
  name              String
  nameMm            String?
  sku               String    @unique
  barcode           String?   @unique
  categoryId        String
  costPrice         Decimal   @default(0) @db.Decimal(18, 2)
  sellingPrice      Decimal   @default(0) @db.Decimal(18, 2)
  stockQuantity     Decimal   @default(0) @db.Decimal(18, 3)
  lowStockThreshold Decimal   @default(10) @db.Decimal(18, 3)
  unit              String    @default("pcs") // pcs, kg, g, liter, ml, pack, box, bottle, dozen, set
  imageUrl          String?
  batchNumber       String?
  expiryDate        DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  productUnits   ProductUnit[]
  purchaseItems  PurchaseItem[]
  stocktakeItems StocktakeItem[]
  promotions     Promotion[]
  quotationItems QuotationItem[]
}

model ProductUnit {
  id               String   @id @default(cuid())
  productId        String
  unitName         String   // box, carton, dozen, pack, etc.
  nameMm           String?
  conversionFactor Decimal  @db.Decimal(18, 3) // Base units per 1 of this unit
  sellingPrice     Decimal  @db.Decimal(18, 2)
  barcode          String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unitName])
  @@index([productId])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?  @unique
  email          String?
  address        String?
  totalPurchases Decimal  @default(0) @db.Decimal(18, 2)
  creditBalance  Decimal  @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal? @db.Decimal(18, 2)
  loyaltyPoints  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales        Sale[]
  salePayments SalePayment[]
  quotations   Quotation[]
}

model Sale {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  clientSaleId  String?  @unique
  customerId    String?
  userId        String
  subtotal      Decimal  @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal  @default(0) @db.Decimal(18, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(18, 2)
  dueAmount     Decimal  @default(0) @db.Decimal(18, 2)
  changeAmount  Decimal  @default(0) @db.Decimal(18, 2)
  pointsEarned  Int      @default(0)
  pointsRedeemed Int     @default(0)
  promotionId   String?
  promotionCode String?
  promotionDiscount Decimal @default(0) @db.Decimal(18, 2)
  paymentMethod String   @default("CASH") // CASH, CARD, MOBILE_BANKING, CREDIT, SPLIT
  paymentStatus  String   @default("PAID") // PAID, PARTIAL, PENDING, FAILED, REVERSED
  paymentReference String?
  paymentProviderResponse String?
  status        String   @default("COMPLETED") // COMPLETED, PARTIALLY_REFUNDED, REFUNDED, VOIDED
  notes         String?
  createdAt     DateTime @default(now())

  customer       Customer?       @relation(fields: [customerId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  promotion      Promotion?      @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       SalePayment[]
  stockMovements StockMovement[]
  adjustments    SaleAdjustment[]
  cashDrawerMovements CashDrawerMovement[]
  convertedQuotations Quotation[] @relation("QuotationConvertedSale")
}

model SalePayment {
  id         String   @id @default(cuid())
  saleId     String?
  customerId String?
  userId     String
  shiftId    String?
  method     String   // CASH, CARD, MOBILE_BANKING, CREDIT
  amount     Decimal  @db.Decimal(18, 2)
  reference  String?
  type       String   @default("CHECKOUT") // CHECKOUT, DEBT_REPAYMENT
  notes      String?
  createdAt  DateTime @default(now())

  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id])
  shift    Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([customerId])
  @@index([userId])
  @@index([shiftId])
}

model SaleAdjustment {
  id                    String   @id @default(cuid())
  saleId                String
  approverUserId        String
  type                  String   // REFUND, PARTIAL_REFUND, VOID
  reason                String
  amount                Decimal  @default(0) @db.Decimal(18, 2)
  paymentMethod         String
  paymentReversalStatus String   @default("PENDING") // PENDING, COMPLETED, FAILED, NOT_REQUIRED
  createdAt             DateTime @default(now())

  sale     Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  approver User @relation(fields: [approverUserId], references: [id])

  @@index([saleId])
  @@index([approverUserId])
}

model SaleItem {
  id               String  @id @default(cuid())
  saleId           String
  productId        String
  quantity         Decimal @default(1) @db.Decimal(18, 3)
  refundedQuantity Decimal @default(0) @db.Decimal(18, 3)
  unitName         String?
  unitFactor       Decimal @default(1) @db.Decimal(18, 3)
  unitPrice        Decimal @default(0) @db.Decimal(18, 2)
  costPrice        Decimal @default(0) @db.Decimal(18, 2) // Historical cost at time of sale
  discount         Decimal @default(0) @db.Decimal(18, 2)
  total            Decimal @default(0) @db.Decimal(18, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  userId        String
  saleId        String?  // Link to sale for OUT/RETURN movements
  quantity      Decimal  @db.Decimal(18, 3)
  type          String   // IN, OUT, ADJUSTMENT, RETURN
  reason        String?
  previousStock Decimal  @db.Decimal(18, 3)
  newStock      Decimal  @db.Decimal(18, 3)
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Decimal  @db.Decimal(18, 2)
  description String?
  userId      String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  cashDrawerMovements CashDrawerMovement[]
}

model Shift {
  id             String   @id @default(cuid())
  userId         String
  openingCash    Decimal  @default(0) @db.Decimal(18, 2)
  closingCash    Decimal? @db.Decimal(18, 2)
  expectedCash   Decimal? @db.Decimal(18, 2)
  actualCash     Decimal? @db.Decimal(18, 2)
  variance       Decimal? @db.Decimal(18, 2)
  status         String   @default("OPEN") // OPEN, CLOSED
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  notes          String?

  user User @relation(fields: [userId], references: [id])
  cashDrawerMovements CashDrawerMovement[]
  salePayments        SalePayment[]

  @@index([userId, status])
}

model CashDrawerMovement {
  id        String   @id @default(cuid())
  shiftId   String?
  saleId    String?
  expenseId String?
  userId    String
  type      String   // OPENING, CASH_SALE, REFUND, VOID, PAID_IN, PAID_OUT, CLOSING
  amount    Decimal  @db.Decimal(18, 2)
  reason    String?
  createdAt DateTime @default(now())

  shift   Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  sale    Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id])

  @@index([shiftId])
  @@index([saleId])
  @@index([expenseId])
  @@index([userId])
  @@index([type])
}

model Settings {
  id                 String  @id @default("default")
  businessName       String  @default("ShwePOS")
  businessNameMm     String? @default("ရွှေPOS")
  address            String?
  phone              String?
  email              String?
  taxRate            Float   @default(0)
  currencySymbol     String  @default("K")
  logo               String?
  receiptFooter      String?
  loyaltyEnabled     Boolean @default(true)
  loyaltyEarnRate    Decimal @default(1000) @db.Decimal(18, 2)
  loyaltyRedeemRate  Decimal @default(10) @db.Decimal(18, 2)
  mobileBankingQrUrl String?
  mobileBankingName  String? @default("KBZPay / WavePay")
}

model InvoiceCounter {
  date    String @id // YYYYMMDD format
  counter Int    @default(0)
}

// Shared rate-limit state for serverless instances. This keeps login throttles
// effective when requests are handled by different Vercel functions.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model DataMigrationAudit {
  id        String   @id @default(cuid())
  userId    String
  action    String
  fileName  String
  fileHash  String
  rowCount  Int
  summary   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  creditBalance Decimal  @default(0) @db.Decimal(18, 2)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  poNumber       String   @unique
  supplierId     String
  userId         String
  subtotal       Decimal  @default(0) @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal  @default(0) @db.Decimal(18, 2)
  dueAmount      Decimal  @default(0) @db.Decimal(18, 2)
  paymentMethod  String   @default("CASH") // CASH, BANK_TRANSFER, MOBILE_BANKING, CREDIT
  status         String   @default("RECEIVED") // RECEIVED, CANCELLED
  notes          String?
  createdAt      DateTime @default(now())

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  items    PurchaseItem[]

  @@index([supplierId])
  @@index([userId])
  @@index([createdAt])
}

model PurchaseItem {
  id              String    @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal   @db.Decimal(18, 3)
  unitCost        Decimal   @db.Decimal(18, 2)
  total           Decimal   @db.Decimal(18, 2)
  batchNumber     String?
  expiryDate      DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  userId     String
  amount     Decimal  @db.Decimal(18, 2)
  method     String   @default("CASH") // CASH, BANK_TRANSFER, MOBILE_BANKING
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([supplierId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model StocktakeSession {
  id                 String    @id @default(cuid())
  sessionNumber      String    @unique
  status             String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  categoryId         String?
  userId             String
  completedById      String?
  notes              String?
  totalItems         Int       @default(0)
  varianceItems      Int       @default(0)
  totalVarianceValue Decimal   @default(0) @db.Decimal(18, 2)
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user        User            @relation("StocktakeCreatedBy", fields: [userId], references: [id])
  completedBy User?           @relation("StocktakeCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  items       StocktakeItem[]

  @@index([status])
  @@index([createdAt])
}

model StocktakeItem {
  id            String   @id @default(cuid())
  sessionId     String
  productId     String
  systemQty     Decimal  @db.Decimal(18, 3)
  countedQty    Decimal? @db.Decimal(18, 3)
  varianceQty   Decimal  @default(0) @db.Decimal(18, 3)
  unitCost      Decimal  @default(0) @db.Decimal(18, 2)
  varianceValue Decimal  @default(0) @db.Decimal(18, 2)
  notes         String?

  session StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id])

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
}

model Promotion {
  id            String   @id @default(cuid())
  name          String
  nameMm        String?
  code          String?  @unique
  type          String   // PERCENT_OFF, FIXED_OFF, BUY_X_GET_Y, MIN_SPEND_PERCENT, MIN_SPEND_FIXED
  discountValue Decimal  @default(0) @db.Decimal(18, 2)
  minSpend      Decimal? @db.Decimal(18, 2)
  buyQty        Int?
  getQty        Int?
  categoryId    String?
  productId     String?
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  sales    Sale[]

  @@index([isActive, startDate, endDate])
  @@index([code])
}

model Quotation {
  id              String   @id @default(cuid())
  quoteNumber     String   @unique
  customerId      String?
  customerName    String?
  customerPhone   String?
  userId          String
  subtotal        Decimal  @default(0) @db.Decimal(18, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, CONVERTED, EXPIRED, CANCELLED
  validUntil      DateTime
  convertedSaleId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user          User            @relation(fields: [userId], references: [id])
  convertedSale Sale?           @relation("QuotationConvertedSale", fields: [convertedSaleId], references: [id], onDelete: SetNull)
  items         QuotationItem[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String
  quantity    Decimal @db.Decimal(18, 3)
  unitName    String?
  unitFactor  Decimal @default(1) @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}
